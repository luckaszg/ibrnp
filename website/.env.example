# Public URL of the site (canonical links, sitemap, Open Graph)
SITE_URL=https://www.ibrnp.com

# Contact form (CT-1). Leave empty to fall back to a mailto: link.
# Any provider that accepts a JSON POST works, e.g. Web3Forms (https://api.web3forms.com/submit).
PUBLIC_CONTACT_ENDPOINT=
PUBLIC_CONTACT_KEY=
