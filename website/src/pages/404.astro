---
import Base from '../layouts/Base.astro';
import Seal from '../components/Seal.astro';
---

<Base lang="es" title="Página no encontrada" alternates={{ es: '/', en: '/en/' }} searchable={false}>
  <section class="section" style="text-align: center">
    <div class="container narrow">
      <div style="display: flex; justify-content: center; margin-bottom: 2rem"><Seal size={120} /></div>
      <h1>Página no encontrada</h1>
      <p class="lede">La página que busca no existe o ha cambiado de dirección.</p>
      <p lang="en" class="muted">Page not found. The page you are looking for does not exist or has moved.</p>
      <p style="margin-top: 2rem; display: flex; gap: 16px; justify-content: center; flex-wrap: wrap">
        <a class="btn" href="/">Ir al inicio</a>
        <a class="btn btn--outline" href="/en/" lang="en">English home page</a>
      </p>
    </div>
  </section>
</Base>
