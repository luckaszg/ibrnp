---
// Shared page shell: <head>, header, footer. `mode` switches between the
// institutional look and the book-like reading look (§5).
import '../styles/global.css';
import '../styles/reading.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { settings } from '../lib/settings.ts';
import type { Lang } from '../lib/scripture.ts';
import type { Alternates } from '../i18n/routes.ts';
import { t } from '../i18n/ui.ts';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  alternates: Alternates;
  mode?: 'institutional' | 'reading';
  /** Extra JSON-LD objects for this page (SO-2). */
  jsonLd?: object[];
  /** Whether pagefind should index this page. */
  searchable?: boolean;
  /** Shown when the visitor is on /en but the content is Spanish (I-3). */
  untranslated?: boolean;
}

const { lang, title, description, alternates, mode = 'institutional', jsonLd = [], searchable = true, untranslated = false } = Astro.props;
const _ = t(lang);
const fullTitle = title === settings.name ? title : `${title} · ${settings.shortName}`;
const desc = description ?? settings.tagline[lang] ?? settings.tagline.es;
const canonical = new URL(alternates[lang], Astro.site);
const ogImage = new URL('/og-image.png', Astro.site);
---

<!doctype html>
<html lang={lang} data-mode={mode}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={new URL(alternates.es, Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(alternates.en, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(alternates.es, Astro.site)} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#002239" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={settings.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
    {
      mode === 'reading' && (
        <script is:inline>
          // Apply saved reader settings before first paint to avoid a flash (RD-5).
          try {
            var s = JSON.parse(localStorage.getItem('ibrnp-reader') || '{}');
            var d = document.documentElement;
            if (s.size) d.dataset.readerSize = s.size;
            if (s.leading) d.dataset.readerLeading = s.leading;
            if (s.theme) d.dataset.readerTheme = s.theme;
          } catch (e) {}
        </script>
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">{_('nav.skip')}</a>
    <Header lang={lang} alternates={alternates} />
    <main id="main" data-pagefind-body={searchable ? '' : undefined}>
      {untranslated && (
        <div class="container narrow">
          <p class="notice untranslated" style="margin-top: 2rem">{_('common.untranslated')}</p>
        </div>
      )}
      <slot />
    </main>
    <Footer lang={lang} alternates={alternates} />
  </body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    left: 16px;
    top: -60px;
    z-index: 100;
    padding: 0.75em 1em;
    background: var(--white);
    color: var(--navy-900);
    font-family: var(--font-label);
    font-size: 0.8rem;
    font-weight: 600;
  }
  .skip-link:focus {
    top: 12px;
  }
  main {
    display: block;
    min-height: 60vh;
  }
</style>
