---
// Sermon archive with filters by book, series, preacher and year, plus text search (SE-2, SE-3).
// All sermons are in the page; filtering and pagination happen in the browser and are kept in the URL.
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SermonCard from '../components/SermonCard.astro';
import { getCollection } from 'astro:content';
import { sermons as allSermons, slugOf } from '../lib/content.ts';
import { alternates, seriesPath } from '../i18n/routes.ts';
import { t, pick } from '../i18n/ui.ts';
import { BOOKS, BOOK_BY_CODE } from '../lib/bible-books.ts';
import { formatRef, parseReferences, refsOnly, type Lang, passageRefs } from '../lib/scripture.ts';
import { settings } from '../lib/settings.ts';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const _ = t(lang);
const sermons = await allSermons();
const series = await getCollection('series');
const preachers = await getCollection('preachers');

const info = sermons.map((s) => {
  const refs = passageRefs(s.data.passage);
  return {
    s,
    books: [...new Set(refs.map((r) => r.book))],
    year: String(s.data.date.getUTCFullYear()),
    text: [pick(s.data.title, lang), refs.map((r) => formatRef(r, lang, 'long')).join(' '), s.data.passage].join(' ').toLowerCase(),
  };
});
const bookCodes = BOOKS.map((b) => b.code).filter((c) => info.some((i) => i.books.includes(c)));
const years = [...new Set(info.map((i) => i.year))].sort().reverse();
const usedSeries = series.filter((x) => sermons.some((s) => s.data.series?.id === x.id));
const usedPreachers = preachers.filter((p) => sermons.some((s) => s.data.preacher.id === p.id));
---

<Base lang={lang} title={_('nav.sermons')} alternates={alternates('sermons')}>
  <PageHero
    lang={lang}
    eyebrow={lang === 'es' ? 'Predicación expositiva' : 'Expository preaching'}
    title={_('nav.sermons')}
    lede={lang === 'es' ? 'Sermones predicados en nuestros cultos del Día del Señor.' : 'Sermons preached at our Lord’s Day services.'}
    placeholder={sermons.some((s) => s.data.placeholder)}
  />

  {
    usedSeries.length > 0 && (
      <section class="section section--tint series-band">
        <div class="container">
          <h2 class="label">{lang === 'es' ? 'Series' : 'Series'}</h2>
          <div class="grid grid--3">
            {usedSeries.map((x) => (
              <a class="card" href={seriesPath(x.id, lang)}>
                <h3>{pick(x.data.title, lang)}</h3>
                <p class="muted">
                  {sermons.filter((s) => s.data.series?.id === x.id).length} {_('sermons.count')}
                </p>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="section">
    <div class="container">
      <form class="filters no-print" data-filters role="search" onsubmit="return false">
        <label class="f-search">
          <span class="label">{_('nav.search')}</span>
          <input type="search" name="q" placeholder={_('sermons.search')} />
        </label>
        <label>
          <span class="label">{_('sermons.filterBook')}</span>
          <select name="libro">
            <option value="">{_('sermons.all')}</option>
            {bookCodes.map((c) => <option value={c}>{BOOK_BY_CODE.get(c)![lang]}</option>)}
          </select>
        </label>
        <label>
          <span class="label">{_('sermons.filterSeries')}</span>
          <select name="serie">
            <option value="">{_('sermons.all')}</option>
            {usedSeries.map((x) => <option value={x.id}>{pick(x.data.title, lang)}</option>)}
          </select>
        </label>
        <label>
          <span class="label">{_('sermons.filterPreacher')}</span>
          <select name="predicador">
            <option value="">{_('sermons.all')}</option>
            {usedPreachers.map((p) => <option value={p.id}>{p.data.name}</option>)}
          </select>
        </label>
        <label>
          <span class="label">{_('sermons.filterYear')}</span>
          <select name="ano">
            <option value="">{_('sermons.all')}</option>
            {years.map((y) => <option value={y}>{y}</option>)}
          </select>
        </label>
      </form>
      <p class="count muted" aria-live="polite" data-count></p>

      <div class="grid grid--3 list" data-sermons>
        {
          info.map(({ s, books, year, text }) => (
            <div data-item data-books={books.join(' ')} data-serie={s.data.series?.id ?? ''} data-predicador={s.data.preacher.id} data-ano={year} data-text={text}>
              <SermonCard sermon={s} lang={lang} />
            </div>
          ))
        }
      </div>
      <p class="empty" hidden data-empty>
        {_('sermons.none')} <button type="button" class="linkish" data-clear>{_('sermons.clear')}</button>
      </p>
      <nav class="pager no-print" data-pager aria-label={lang === 'es' ? 'Páginas' : 'Pages'}></nav>

      {
        settings.youtubeChannel && (
          <p class="channel">
            <a href={settings.youtubeChannel} target="_blank" rel="noopener">
              {_('sermons.channel')} ↗
            </a>
          </p>
        )
      }
    </div>
  </section>
</Base>

<script>
  const PER_PAGE = 12;
  const form = document.querySelector<HTMLFormElement>('[data-filters]')!;
  const items = [...document.querySelectorAll<HTMLElement>('[data-item]')];
  const pager = document.querySelector<HTMLElement>('[data-pager]')!;
  const count = document.querySelector<HTMLElement>('[data-count]')!;
  const empty = document.querySelector<HTMLElement>('[data-empty]')!;
  const es = document.documentElement.lang === 'es';
  const fields = ['q', 'libro', 'serie', 'predicador', 'ano'] as const;
  let page = 1;

  // Restore filters from the URL.
  const params = new URLSearchParams(location.search);
  for (const f of fields) {
    const el = form.elements.namedItem(f) as HTMLInputElement | HTMLSelectElement | null;
    if (el && params.get(f)) el.value = params.get(f)!;
  }
  page = Number(params.get('pagina') || 1);

  function render(push = false) {
    const v = Object.fromEntries(fields.map((f) => [f, ((form.elements.namedItem(f) as HTMLInputElement).value || '').trim()]));
    const q = v.q.toLowerCase();
    const matches = items.filter((el) => {
      const d = el.dataset;
      return (
        (!v.libro || d.books!.split(' ').includes(v.libro)) &&
        (!v.serie || d.serie === v.serie) &&
        (!v.predicador || d.predicador === v.predicador) &&
        (!v.ano || d.ano === v.ano) &&
        (!q || d.text!.includes(q))
      );
    });
    const pages = Math.max(1, Math.ceil(matches.length / PER_PAGE));
    page = Math.min(Math.max(1, page), pages);
    items.forEach((el) => (el.hidden = true));
    matches.slice((page - 1) * PER_PAGE, page * PER_PAGE).forEach((el) => (el.hidden = false));
    empty.hidden = matches.length > 0;
    count.textContent = es ? `${matches.length} sermón(es)` : `${matches.length} sermon(s)`;
    pager.innerHTML = '';
    if (pages > 1) {
      for (let i = 1; i <= pages; i++) {
        const b = document.createElement('button');
        b.type = 'button';
        b.textContent = String(i);
        if (i === page) b.setAttribute('aria-current', 'page');
        b.addEventListener('click', () => {
          page = i;
          render(true);
          form.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
        pager.appendChild(b);
      }
    }
    const url = new URL(location.href);
    for (const f of fields) v[f] ? url.searchParams.set(f, v[f]) : url.searchParams.delete(f);
    page > 1 ? url.searchParams.set('pagina', String(page)) : url.searchParams.delete('pagina');
    history[push ? 'pushState' : 'replaceState'](null, '', url);
  }

  form.addEventListener('input', () => {
    page = 1;
    render();
  });
  document.querySelector('[data-clear]')?.addEventListener('click', () => {
    form.reset();
    page = 1;
    render();
  });
  render();
</script>

<style>
  .series-band .label {
    color: var(--brass-700);
    margin-bottom: 20px;
  }
  .series-band h3 {
    font-size: 1.4rem;
  }
  .filters {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    margin-bottom: 16px;
  }
  .f-search {
    grid-column: 1 / -1;
  }
  @media (min-width: 1080px) {
    .filters {
      grid-template-columns: 2fr repeat(4, 1fr);
    }
    .f-search {
      grid-column: auto;
    }
  }
  .filters label {
    display: grid;
    gap: 6px;
  }
  .filters .label {
    color: var(--brass-700);
  }
  .filters input,
  .filters select {
    min-height: 48px;
    padding: 0 12px;
    border: 1px solid var(--navy-200);
    border-radius: 2px;
    background: var(--white);
    color: var(--navy-900);
    font: inherit;
    font-size: 1rem;
  }
  .filters input:focus,
  .filters select:focus {
    outline: 2px solid var(--brass-700);
    outline-offset: 0;
  }
  .count {
    font-size: 0.95rem;
    margin-bottom: 24px;
  }
  .list > [hidden] {
    display: none;
  }
  .list > div {
    display: flex;
  }
  .list :global(.card) {
    flex: 1;
  }
  .linkish {
    background: none;
    border: 0;
    padding: 0;
    color: var(--navy-900);
    text-decoration: underline;
    font: inherit;
    cursor: pointer;
  }
  .pager {
    display: flex;
    gap: 8px;
    justify-content: center;
    margin-top: 40px;
  }
  .pager :global(button) {
    min-width: 44px;
    min-height: 44px;
    border: 1px solid var(--navy-200);
    background: var(--white);
    color: var(--navy-900);
    font-family: var(--font-label);
    font-weight: 600;
    cursor: pointer;
  }
  .pager :global(button[aria-current='page']) {
    background: var(--navy-900);
    color: var(--white);
    border-color: var(--navy-900);
  }
  .channel {
    margin-top: 48px;
    text-align: center;
    font-family: var(--font-label);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
</style>
