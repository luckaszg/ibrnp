---
import MarkdownPage from './MarkdownPage.astro';
import { route, routeAvailable } from '../i18n/routes.ts';
import { t } from '../i18n/ui.ts';
import type { Lang } from '../lib/scripture.ts';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const _ = t(lang);
const docs = [
  { key: 'confession', title: _('nav.confession'), text: _('beliefs.confessionBlurb') },
  { key: 'catechism', title: _('nav.catechism'), text: _('beliefs.catechismBlurb') },
  { key: 'covenant', title: _('nav.covenant'), text: lang === 'es' ? 'El compromiso de los miembros entre sí y delante de Dios.' : "Members' commitment to one another before God." },
  { key: 'gospel', title: _('nav.gospel'), text: _('beliefs.gospelBlurb') },
].filter((d) => routeAvailable(d.key));
---

<MarkdownPage lang={lang} slug="creemos" routeKey="beliefs" mode="reading">
  <div slot="before" class="container docs">
    {
      docs.map((d) => (
        <a class="doc" href={route(d.key, lang)}>
          <h2>{d.title}</h2>
          <p>{d.text}</p>
          <span class="label">{_('common.readMore')} →</span>
        </a>
      ))
    }
  </div>
</MarkdownPage>

<style>
  .docs {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    margin-bottom: clamp(48px, 6vw, 72px);
  }
  .doc {
    display: flex;
    flex-direction: column;
    padding: 28px 24px;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-top: 3px solid var(--navy-900);
    color: var(--fg);
    text-decoration: none;
    transition: border-color 120ms ease;
  }
  .doc:hover {
    border-color: var(--accent);
    border-top-color: var(--accent);
  }
  .doc h2 {
    font-size: 1.5rem;
    margin-bottom: 0.4em;
  }
  .doc p {
    font-size: 1rem;
    flex: 1;
  }
  .doc .label {
    color: var(--accent);
  }
</style>
