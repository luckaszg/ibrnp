---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Provisional from '../components/Provisional.astro';
import { getCollection, render } from 'astro:content';
import { page } from '../lib/content.ts';
import { alternates } from '../i18n/routes.ts';
import { pick } from '../i18n/ui.ts';
import type { Lang } from '../lib/scripture.ts';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const { entry } = await page('historia', lang);
const { Content } = await render(entry);
const all = (await getCollection('history')).sort((a, b) => a.data.year.localeCompare(b.data.year) || a.id.localeCompare(b.id));
const parts = [
  { key: 'heritage', title: lang === 'es' ? 'Nuestra herencia' : 'Our heritage' },
  { key: 'church', title: lang === 'es' ? 'Nuestra iglesia' : 'Our church' },
].filter((part) => all.some((h) => h.data.part === part.key));
---

<Base lang={lang} title={entry.data.title} description={entry.data.description} alternates={alternates('history')}>
  <PageHero lang={lang} eyebrow={lang === 'es' ? 'Quiénes somos' : 'About us'} title={entry.data.title} lede={entry.data.description}>
    <div class="intro"><Content /></div>
  </PageHero>
  {
    parts.map((part, i) => (
      <section class:list={['section', { 'section--tint': i === 1 }]}>
        <div class="container narrow">
          <h2 class="part-title">{part.title}</h2>
          <ol class="timeline">
            {all
              .filter((h) => h.data.part === part.key)
              .map((h) => (
                <li>
                  <span class="year">{h.data.year}</span>
                  <div>
                    <Provisional lang={lang} show={h.data.placeholder} />
                    <h3>{pick(h.data.title, lang)}</h3>
                    <p>{pick(h.data.description, lang)}</p>
                  </div>
                </li>
              ))}
          </ol>
        </div>
      </section>
    ))
  }
</Base>

<style>
  .intro {
    max-width: 640px;
    margin: 1.5rem auto 0;
    font-size: 1.1rem;
  }
  .part-title {
    text-align: center;
    margin-bottom: 2.5rem;
  }
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
  }
  .timeline::before {
    content: '';
    position: absolute;
    left: 88px;
    top: 8px;
    bottom: 8px;
    width: 1px;
    background: var(--navy-200);
  }
  .timeline li {
    position: relative;
    display: grid;
    grid-template-columns: 72px 1fr;
    gap: 40px;
    padding-bottom: 36px;
  }
  .timeline li::before {
    content: '';
    position: absolute;
    left: 84px;
    top: 10px;
    width: 9px;
    height: 9px;
    background: var(--brass-700);
    transform: rotate(45deg);
  }
  .year {
    font-family: var(--font-display);
    font-size: 1.6rem;
    line-height: 1.1;
    text-align: right;
    color: var(--navy-900);
  }
  .timeline h3 {
    margin-bottom: 0.3em;
  }
  .timeline p {
    margin: 0;
  }
  @media (max-width: 520px) {
    .timeline::before {
      left: 4px;
    }
    .timeline li {
      grid-template-columns: 1fr;
      gap: 4px;
      padding-left: 28px;
    }
    .timeline li::before {
      left: 0;
    }
    .year {
      text-align: left;
      font-size: 1.3rem;
    }
  }
</style>
