---
// Service times from settings — the single source for hero, footer and Visit us (AC-4).
import { settings } from '../lib/settings.ts';
import { DAYS, pick } from '../i18n/ui.ts';
import type { Lang } from '../lib/scripture.ts';

interface Props {
  lang: Lang;
  compact?: boolean;
}
const { lang, compact = false } = Astro.props;
---

<dl class:list={['times', { compact }]}>
  {
    settings.serviceTimes.map((s) => (
      <div class="row">
        <dt>
          <span class="day">{DAYS[s.day][lang]}</span> <span class="time">{s.time}</span>
        </dt>
        <dd>{pick(s.label, lang)}</dd>
      </div>
    ))
  }
</dl>

<style>
  .times {
    margin: 0;
    display: grid;
    gap: 14px;
  }
  .row {
    display: grid;
    gap: 2px;
  }
  dt {
    font-family: var(--font-label);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .time {
    color: var(--fg);
    margin-left: 0.4em;
  }
  dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.25rem;
    line-height: 1.3;
  }
  .compact {
    gap: 10px;
  }
  .compact dd {
    font-family: var(--font-body);
    font-size: 1rem;
    color: #dbe3ec;
  }
</style>
