{
  "name": "ibrnp-website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check",
    "placeholders": "node scripts/placeholders.mjs",
    "test": "node --test \"tests/*.test.ts\"",
    "test:e2e": "playwright test",
    "deploy": "wrangler deploy --config wrangler.jsonc",
    "deploy:preview": "wrangler versions upload --config wrangler.jsonc"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/eb-garamond": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "astro": "^7.4.1",
    "fflate": "^0.8.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.56.1",
    "pagefind": "^1.5.2",
    "wrangler": "^4.151.3"
  }
}
